&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Ссылка = Объект.Ссылка;
	Дата = Объект.Дата;
	ДатаПроведенияРабот = Объект.ДатаПроведенияРабот;
	ВремяНачалаРабот = Объект.ВремяНачалаРабот;
	ВремяОкончанияРабот = Объект.ВремяОкончанияРабот;
	Специалист = Объект.Специалист;
	СимволыПС = Символы.ПС;
	ФорматВремени = "ДЛФ=В";
	Если Ссылка.Пустая() Тогда
		ПустаяДата = Дата('00010101');
		СообщениеТекст = СтрШаблон("Новый документ. Дата: %1", Дата);
		Если ДатаПроведенияРабот <> ПустаяДата Тогда
			СообщениеТекст = СтрШаблон("%1%2Дата проведения работ: %3", СообщениеТекст, СимволыПС, ДатаПроведенияРабот);
		КонецЕсли; 
		Если ВремяНачалаРабот <> ПустаяДата Тогда
			СообщениеТекст = СтрШаблон("%1%2Время начала работ: %3", СообщениеТекст, СимволыПС, Формат(ВремяНачалаРабот, ФорматВремени));
		КонецЕсли; 
		Если ВремяОкончанияРабот <> ПустаяДата Тогда
			СообщениеТекст = СтрШаблон("%1%2Время окончания работ: %3", СообщениеТекст, СимволыПС, Формат(ВремяОкончанияРабот, ФорматВремени));
		КонецЕсли; 
		Если Не ПустаяСтрока(Специалист) Тогда
			СообщениеТекст = СтрШаблон("%1%2Специалист: %3", СообщениеТекст, СимволыПС, Специалист);
		КонецЕсли; 
	Иначе
		Запрос = Новый Запрос; 
		Запрос.Текст = "ВЫБРАТЬ
		|	ВКМ_ОбслуживаниеКлиента.Дата,
		|	ВКМ_ОбслуживаниеКлиента.ДатаПроведенияРабот,
		|	ВКМ_ОбслуживаниеКлиента.ВремяНачалаРабот,
		|	ВКМ_ОбслуживаниеКлиента.ВремяОкончанияРабот,
		|	ВКМ_ОбслуживаниеКлиента.Специалист
		|ИЗ
		|	Документ.ВКМ_ОбслуживаниеКлиента КАК ВКМ_ОбслуживаниеКлиента
		|ГДЕ
		|	ВКМ_ОбслуживаниеКлиента.Ссылка = &Ссылка
		|	И НЕ (ВКМ_ОбслуживаниеКлиента.Дата = &Дата
		|	И ВКМ_ОбслуживаниеКлиента.ДатаПроведенияРабот = &ДатаПроведенияРабот
		|	И ВКМ_ОбслуживаниеКлиента.ВремяНачалаРабот = &ВремяНачалаРабот
		|	И ВКМ_ОбслуживаниеКлиента.ВремяОкончанияРабот = &ВремяОкончанияРабот
		|	И ВКМ_ОбслуживаниеКлиента.Специалист = &Специалист)"; 
		Запрос.УстановитьПараметр("Ссылка", Ссылка); 
		Запрос.УстановитьПараметр("Дата", Дата); 
		Запрос.УстановитьПараметр("ДатаПроведенияРабот", ДатаПроведенияРабот); 
		Запрос.УстановитьПараметр("ВремяНачалаРабот", ВремяНачалаРабот); 
		Запрос.УстановитьПараметр("ВремяОкончанияРабот", ВремяОкончанияРабот); 
		Запрос.УстановитьПараметр("Специалист", Специалист); 
		Выборка = Запрос.Выполнить().Выбрать(); 
		Если Выборка.Следующий() Тогда 
			СообщениеТекст = "Документ изменен:";
			ВыборкаДата =  Выборка.Дата;
			Если ВыборкаДата <> Дата Тогда
				СообщениеТекст = СтрШаблон("%1%2Предыдущая дата: %3 Новая дата: %4", СообщениеТекст, СимволыПС, ВыборкаДата, Дата);
			КонецЕсли; 
			ВыборкаДатаПроведенияРабот = Выборка.ДатаПроведенияРабот;
			Если ВыборкаДатаПроведенияРабот <> ДатаПроведенияРабот Тогда
				СообщениеТекст = СтрШаблон("%1%2Старая дата проведения работ: %3 Новая дата проведения работ: %4", СообщениеТекст, СимволыПС, ВыборкаДатаПроведенияРабот, ДатаПроведенияРабот);
			КонецЕсли;
			ВыборкаВремяНачалаРабот = Выборка.ВремяНачалаРабот;
			Если ВыборкаВремяНачалаРабот <> ВремяНачалаРабот Тогда
				СообщениеТекст = СтрШаблон("%1%2Старое время начала работ: %3 Новое время начала работ: %4", СообщениеТекст, СимволыПС, Формат(ВыборкаВремяНачалаРабот, ФорматВремени), Формат(ВремяНачалаРабот, ФорматВремени));
			КонецЕсли; 
			ВыборкаВремяОкончанияРабот = Выборка.ВремяОкончанияРабот;
			Если ВыборкаВремяОкончанияРабот <> ВремяОкончанияРабот Тогда
				СообщениеТекст = СтрШаблон("%1%2Старое время окончания работ: %3 Новое время окончания работ: %4", СообщениеТекст, СимволыПС, ВыборкаВремяОкончанияРабот, ВремяОкончанияРабот);
			КонецЕсли;
			ВыборкаСпециалист = Выборка.Специалист;
			Если ВыборкаСпециалист <> Специалист Тогда
				СообщениеТекст = СтрШаблон("%1%2Предыдущий специалист: %3 Текущий специалист: %4", СообщениеТекст, СимволыПС, ВыборкаСпециалист, Специалист);
			КонецЕсли; 
		Иначе
			СообщениеТекст = "";
		КонецЕсли; 
	КонецЕсли; 
	Если Не ПустаяСтрока(СообщениеТекст) Тогда 
		НовыйЭлемент = Справочники.ВКМ_УведомленияТелеграмБотуДляОтправки.СоздатьЭлемент(); 
		НовыйЭлемент.Текст = СообщениеТекст; 
		НовыйЭлемент.Записать();
	КонецЕсли;
	 	
КонецПроцедуры

#КонецОбласти

